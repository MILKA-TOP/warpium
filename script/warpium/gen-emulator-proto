#!/usr/bin/env bash
# Regenerates crates/warpium_emulator/src/proto/generated.rs from the vendored .proto files.
# Uses protox (a pure-Rust protobuf compiler), so neither protoc nor a build.rs is needed, and the
# generator lives in its own workspace so its dependencies stay out of the main Cargo.lock.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
crate_dir="$repo_root/crates/warpium_emulator"
codegen_dir="$crate_dir/codegen"

cargo run --quiet --manifest-path "$codegen_dir/Cargo.toml" \
  --target-dir "${WARPIUM_CODEGEN_TARGET_DIR:-$repo_root/target/warpium_emulator_codegen}" -- "$crate_dir"
rustfmt --edition 2024 "$crate_dir/src/proto/generated.rs"
