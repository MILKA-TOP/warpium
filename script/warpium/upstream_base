#!/usr/bin/env bash
#
# Prints the upstream Warp commit a Warpium commit is based on: the merge base of that commit with
# warpdotdev/warp master, i.e. the newest upstream master commit it contains. Builds embed it as
# WARPIUM_UPSTREAM_BASE so the app can tell how many upstream commits it lacks.
#
# Usage: script/warpium/upstream_base [--sha <commit>] [--repo <owner/name>]
#   --sha   the Warpium commit (default: HEAD); it must be pushed to GitHub for the API lookup
#   --repo  the fork holding it (default: $GITHUB_REPOSITORY, else MILKA-TOP/warpium)
#
# Asks the GitHub compare API first (uses $GITHUB_TOKEN or $GH_TOKEN when set). If that fails,
# falls back to `git merge-base` with a local remote-tracking branch of warpdotdev/warp master,
# which is only as fresh as your last fetch of that remote.

set -euo pipefail

UPSTREAM_REPO="warpdotdev/warp"
UPSTREAM_BRANCH="master"
sha=""
repo="${GITHUB_REPOSITORY:-MILKA-TOP/warpium}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --sha) sha="${2:?--sha needs a value}"; shift 2 ;;
    --repo) repo="${2:?--repo needs a value}"; shift 2 ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    *) echo "error: unknown argument $1" >&2; exit 2 ;;
  esac
done

if [[ -z "$sha" ]]; then
  sha="$(git rev-parse HEAD)"
fi

is_sha() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]]
}

from_api() {
  local token="${GITHUB_TOKEN:-${GH_TOKEN:-}}" auth=() response base
  if [[ -n "$token" ]]; then
    auth=(-H "Authorization: Bearer $token")
  fi
  # Page 2 skips the changed-files list, which only page 1 carries; every page has the merge base.
  response="$(curl -fsSL --retry 3 --max-time 60 \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    ${auth[@]+"${auth[@]}"} \
    "https://api.github.com/repos/$UPSTREAM_REPO/compare/$UPSTREAM_BRANCH...${repo%%/*}:${repo##*/}:$sha?per_page=1&page=2")" || return 1
  base="$(jq -r '.merge_base_commit.sha // empty' <<<"$response")" || return 1
  is_sha "$base" && printf '%s\n' "$base"
}

from_local_remote() {
  local remote url base
  for remote in $(git remote); do
    url="$(git remote get-url "$remote")"
    if [[ "$url" =~ github\.com[:/]$UPSTREAM_REPO(\.git)?/?$ ]] &&
      git rev-parse --verify --quiet "refs/remotes/$remote/$UPSTREAM_BRANCH" >/dev/null; then
      base="$(git merge-base "$sha" "refs/remotes/$remote/$UPSTREAM_BRANCH")" || continue
      echo "warning: using local $remote/$UPSTREAM_BRANCH; fetch it first for an accurate base" >&2
      printf '%s\n' "$base"
      return 0
    fi
  done
  return 1
}

if from_api; then
  exit 0
fi
echo "warning: GitHub compare lookup for $repo@$sha failed; trying a local upstream remote" >&2
if from_local_remote; then
  exit 0
fi
echo "error: could not determine the upstream base of $sha" >&2
exit 1
